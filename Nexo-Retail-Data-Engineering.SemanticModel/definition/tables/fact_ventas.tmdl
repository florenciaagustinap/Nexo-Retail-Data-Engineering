table fact_ventas
	lineageTag: c46fd2aa-051e-49f0-b50c-7ab1915497e0

	measure 'Ventas Totales' = SUM ( fact_ventas[facturacion] )
		formatString: #,##0.00
		lineageTag: 64971146-8257-4ed1-8423-0e8668fbfd11

	measure 'Costo Total' = SUM ( fact_ventas[costo_total] )
		formatString: #,##0.00
		lineageTag: 47cf3f53-9f27-47c1-a948-7b0347377ae0

	measure 'Margen Bruto' = [Ventas Totales] - [Costo Total]
		formatString: #,##0.00
		lineageTag: 6903b304-db62-4d48-bc19-7ec3bb7a5d53

	measure 'Margen %' = DIVIDE ( [Margen Bruto], [Ventas Totales] )
		formatString: 0.0%
		lineageTag: a18d4df7-46ce-4791-9938-fd4932b4b04f

	measure 'Ventas Netas' = [Ventas Totales] - [Valor Devuelto]
		formatString: #,##0.00
		lineageTag: 534105c9-b3b3-4c3b-a306-910c907b5e4f

	measure 'Unidades Vendidas' = SUM ( fact_ventas[cantidad] )
		formatString: #,##0
		lineageTag: 51c42976-7d8a-40fd-bbff-6733a115a793

	measure 'Variación % Ventas' =
			VAR Actual =
			    [Ventas Totales]
			VAR Anterior =
			    CALCULATE (
			        [Ventas Totales],
			        SAMEPERIODLASTYEAR ( dim_fecha[fecha] )
			    )
			RETURN
			    DIVIDE ( Actual - Anterior, Anterior )
		formatString: 0.0%
		lineageTag: 7b71e3d5-cebc-4c57-9204-941fc4765435

	measure 'Variación pp Margen' =
			[Margen %]
			    - CALCULATE (
			        [Margen %],
			        SAMEPERIODLASTYEAR ( dim_fecha[fecha] )
			    )
		formatString: 0.0%
		lineageTag: 9ed2ff51-93c3-43f7-8774-27b198713a8f

