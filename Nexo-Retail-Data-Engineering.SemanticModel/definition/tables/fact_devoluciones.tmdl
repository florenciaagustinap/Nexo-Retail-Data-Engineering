table fact_devoluciones
	lineageTag: 8034f4f0-9f9d-4554-827c-efcc4e1fbdf4

	measure 'Valor Devuelto' = SUM ( fact_devoluciones[valor_devuelto] )
		formatString: #,##0.00
		lineageTag: c83b6698-bafc-4690-bd86-4380fbadf5be

	measure 'Unidades Devueltas' = SUM ( fact_devoluciones[cantidad_devuelta] )
		formatString: #,##0
		lineageTag: 7f680052-274b-4213-b0ee-ed354441d5e7

	measure 'Tasa de Devolución %' = DIVIDE ( [Valor Devuelto], [Ventas Totales] )
		formatString: 0.0%
		lineageTag: 1865b84e-cd95-459c-bc8b-52be4cc63b89

	measure 'Variación % Devoluciones' =
			VAR Actual =
			    [Valor Devuelto]
			VAR Anterior =
			    CALCULATE (
			        [Valor Devuelto],
			        SAMEPERIODLASTYEAR ( dim_fecha[fecha] )
			    )
			RETURN
			    DIVIDE ( Actual - Anterior, Anterior )
		formatString: 0.0%
		lineageTag: 71687159-a7a8-4f8e-a59d-da0f0a55c6c6

