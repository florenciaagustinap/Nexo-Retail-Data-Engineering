table fact_objetivos
	lineageTag: 42843cda-5118-445d-ba41-ca8c83e4d5b4

	measure 'Objetivo de Ventas' = SUM ( fact_objetivos[objetivo_ventas] )
		formatString: #,##0.00
		lineageTag: f4f1c233-0fbe-4547-9dd8-a271ecfb088e

	measure 'Cumplimiento de Objetivo %' =
			VAR AniosConObjetivo =
			    FILTER (
			        VALUES ( dim_fecha[anio] ),
			        NOT ISBLANK ( [Objetivo de Ventas] )
			    )
			VAR VentasAlineadas =
			    CALCULATE ( [Ventas Totales], AniosConObjetivo )
			RETURN
			    DIVIDE ( VentasAlineadas, [Objetivo de Ventas] )
		formatString: 0.0%
		lineageTag: 36716e2c-b979-47f6-8157-5e0015feee31

	measure 'Brecha vs Objetivo' =
			VAR AniosConObjetivo =
			    FILTER (
			        VALUES ( dim_fecha[anio] ),
			        NOT ISBLANK ( [Objetivo de Ventas] )
			    )
			VAR VentasAlineadas =
			    CALCULATE ( [Ventas Totales], AniosConObjetivo )
			VAR Obj =
			    [Objetivo de Ventas]
			RETURN
			    IF (
			        ISBLANK ( Obj ),
			        BLANK (),
			        VentasAlineadas - Obj
			    )
		formatString: #,##0.00
		lineageTag: c1bfcb21-88d9-4563-ac1b-d8cc5180acb8

	column objetivo_key
		dataType: int64
		formatString: 0
		lineageTag: 59376e02-7d43-42d2-8949-37ea14344bd0
		summarizeBy: sum
		sourceColumn: objetivo_key

		annotation SummarizationSetBy = Automatic

	column fecha_key
