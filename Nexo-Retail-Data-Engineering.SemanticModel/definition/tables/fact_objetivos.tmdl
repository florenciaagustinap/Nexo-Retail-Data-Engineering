		formatString: 0
		lineageTag: f5c6633d-4b5e-486b-9b5e-f97cf4266535
		summarizeBy: none
		sourceColumn: fecha_key

		annotation SummarizationSetBy = Automatic

	column tienda_key
		dataType: int64
		formatString: 0
		lineageTag: 9b838ec9-420d-4bb0-9199-90ba9c142ee7
		summarizeBy: none
		sourceColumn: tienda_key

		annotation SummarizationSetBy = Automatic

	column objetivo_ventas
		dataType: double
		lineageTag: cb47c643-e6e6-4a32-baa2-4ce863b319aa
		summarizeBy: sum
		sourceColumn: objetivo_ventas

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

